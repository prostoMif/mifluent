# Mifluent in production: docker compose on one server.
#
#   cp .env.production.example .env
#
# Six values are required: PUBLIC_HOST, POSTGRES_PASSWORD, BETTER_AUTH_SECRET,
# ENCRYPTION_KEY, BACKUP_PASSPHRASE, and the four LLM_* settings (one block).
# Everything else can stay as it is. Nothing below is a real value.
#
# Keep a copy of this file somewhere other than the server and other than the
# backups: ENCRYPTION_KEY and BACKUP_PASSPHRASE cannot be recovered.

# --- Address ------------------------------------------------------------
# The public host name. Without a domain: your server's IP with dashes plus
# .sslip.io, e.g. 203-0-113-7.sslip.io. Caddy gets the certificate itself.
PUBLIC_HOST=
# Both must be https:// followed by PUBLIC_HOST.
BETTER_AUTH_URL=https://
APP_URL=https://

# --- Secrets --------------------------------------------------------------
# Database password, used only between containers. openssl rand -hex 24
POSTGRES_PASSWORD=
# Session secret. openssl rand -base64 48
BETTER_AUTH_SECRET=
# Encrypts model keys people store. openssl rand -base64 32
ENCRYPTION_KEY=
# Encrypts the daily database backups. openssl rand -base64 32
# Store it away from the backups, or they are not encrypted in any useful sense.
BACKUP_PASSPHRASE=

# --- Language model (OpenAI-compatible API) --------------------------------
# A server in Russia cannot reach OpenAI, Anthropic, Gemini or DeepSeek
# directly: use a Russian intermediary with an OpenAI-compatible endpoint
# (for example ProxyAPI: LLM_BASE_URL=https://api.proxyapi.ru/openai/v1).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_DEEP=
# USD per million tokens, from your provider's price list (convert roubles
# at today's rate). Required in production: the daily cap below is a sum of
# these, and the worker refuses to start while they are 0.
LLM_PRICE_CHEAP_IN=0
LLM_PRICE_CHEAP_OUT=0
LLM_PRICE_DEEP_IN=0
LLM_PRICE_DEEP_OUT=0
# Hard daily ceiling on model spend for the whole instance, USD.
DAILY_COST_CAP_USD=1.0

# External healthcheck URL (e.g., healthchecks.io). If set, a GET request is
# sent every 5 minutes from the heartbeat loop.
HEALTHCHECK_PING_URL=

# Telegram chat ID of the instance owner. If set, daily reports and instant
# alerts are sent here.
OWNER_TELEGRAM_CHAT_ID=

# --- RSSHub (optional; for Telegram channels) -------------------------------
# Default: http://rsshub:1200 (internal Docker network).
RSSHUB_URL=

# --- Telegram (optional) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# openssl rand -hex 32, then:
#   docker compose exec worker npm run telegram:webhook --workspace @mifluent/worker
TELEGRAM_WEBHOOK_SECRET=

# --- Email (optional; password reset and digest delivery) ----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# openssl rand -base64 32
EMAIL_LINK_SECRET=
# Reply address for digests (optional; defaults to SMTP_FROM)
FEEDBACK_EMAIL=
# Who runs the service — shown in the offer (/terms), the privacy policy
# (/privacy) and the contacts. ЮKassa moderation and 152-ФЗ need them.
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_TELEGRAM=

# --- Instance ------------------------------------------------------------
# The first account can always be created, and becomes the owner — create
# yours right after the first start. After that, people join by invitation.
REGISTRATION_OPEN=false
DEFAULT_TIMEZONE=UTC
DIGEST_DEFAULT_TIME=08:00
LOG_LEVEL=info

# --- Payments (ЮKassa) ------------------------------------------------------
# Shop id and secret key from the ЮKassa dashboard (Интеграция → Ключи API).
# Without both, the pricing page shows "payments open soon". In the dashboard
# set the HTTP notification URL to https://<your host>/api/billing/yookassa
# with the events payment.succeeded and payment.canceled.
# Receipts for самозанятый go to «Мой налог» through ЮKassa automatically; the
# owner also gets a Telegram message for every payment.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true only if the shop accepts foreign currency: then dollar prices are payable.
YOOKASSA_ALLOW_USD=false
# How many first Pro accounts get the early price.
EARLY_SEATS=100

# --- Public radar (optional, see radar/README.md) ----------------------------
# RADAR_TENANT_ID=
# RADAR_TELEGRAM_CHANNEL_ID=@mifluent_radar
# RADAR_BOT_LINK=https://t.me/mifluent_bot
# RADAR_SITE_LINK=https://mifluent.com
