{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/nemotron-3-ultra-free",
  "permission": {
    "bash": {
      "git checkout*": "deny",
      "git restore*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "git push*": "deny",
      "git rebase*": "deny",
      "rm -rf*": "deny"
    }
  }
}
