# Mifluent configuration.
#
# Copy to .env and fill in. There is no config file — environment variables are
# the only source of configuration, they are parsed by one Zod schema at
# startup, and a missing required variable stops the process with a list of what
# is absent rather than failing halfway through the first request.
#
# Never commit .env. Nothing below is a real value.

# ---------------------------------------------------------------------------
# Required — the process will not start without these
# ---------------------------------------------------------------------------

# PostgreSQL 16 or later with the pgvector extension.
DATABASE_URL=postgres://mifluent:mifluent@localhost:5432/mifluent

# Session secret, at least 32 characters.
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=

# The public address of this instance. Must match how it is actually reached,
# or logins will fail in ways that look like something else.
BETTER_AUTH_URL=http://localhost:3000

# Encrypts user model keys at the field level. Separate from the session secret
# on purpose: rotating one should not force rotating the other.
# Generate: openssl rand -base64 32
#
# Losing this key means every stored model key becomes unreadable. Back it up
# somewhere that is NOT the same backup as the database.
ENCRYPTION_KEY=

# Base URL used for links inside digests and emails.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional — each one switches a feature on; without it that feature is off
# ---------------------------------------------------------------------------

# Language models. Without these, collection and filtering still work; fact
# extraction and interpretation do not.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_CHEAP=
LLM_MODEL_DEEP=

# Model pricing in USD per 1 million tokens. Used for cost tracking.
# Defaults to 0 if not set. Set these to your provider's published rates.
LLM_PRICE_CHEAP_IN=0
LLM_PRICE_CHEAP_OUT=0
LLM_PRICE_DEEP_IN=0
LLM_PRICE_DEEP_OUT=0

# Delivery via Telegram. Create a bot with @BotFather and paste the token.
TELEGRAM_BOT_TOKEN=
# The bot's username without @, shown in the "send /start <code>" instruction.
TELEGRAM_BOT_USERNAME=
# Secret for the webhook path and header. At least 32 characters.
# Generate: openssl rand -hex 32. Then register it: npm run telegram:webhook
TELEGRAM_WEBHOOK_SECRET=
# Local development only: the worker polls Telegram instead of receiving a
# webhook, because a laptop has no public address.
TELEGRAM_POLLING=false

# Shared secret for POST /api/billing/webhook, the stand-in for a payment
# provider until there is one. Unset means the endpoint refuses everything.
# Generate: openssl rand -hex 32
BILLING_WEBHOOK_SECRET=

# Email. Used for password reset, and later for digest delivery.
#
# Leaving these empty is fine: the instance starts normally and the password
# reset screen says the feature is unavailable rather than failing silently.
# The console command below works either way:
#
#   npm run account:set-password -- someone@example.com
#
# Without a domain of your own, use the SMTP server of a mailbox you already
# have. Gmail, for example, works with a 16-character app password (Settings,
# 2-Step Verification, App passwords) and allows 500 messages a day:
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER / SMTP_FROM = the same Gmail address
#
# What does NOT work is a relay such as Brevo or Mailgun sending "from" a
# gmail.com address: Google publishes a DMARC policy for its own domain, so
# those messages are rejected or filed as spam. A relay needs a domain you own.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Sign-in with Google. Email and password sign-in works without this.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reddit connector. Register an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Where the "report a problem" button sends people. Leave empty and the button
# still works — it assembles the report for you to copy, it just has nowhere to
# point you afterwards. Nothing is ever sent from the instance on its own.
ISSUE_TRACKER_URL=

# ---------------------------------------------------------------------------
# Tuning — sensible defaults, change only if you have a reason
# ---------------------------------------------------------------------------

# Parallel jobs per worker process. Raising this mostly buys you rate limits
# from the sources you are polling.
WORKER_CONCURRENCY=4

# debug | info | warn | error
LOG_LEVEL=info

# Open registration. Switches itself off after the first account is created;
# set to true deliberately to invite more people to this instance.
REGISTRATION_OPEN=false

# IANA timezone used for new profiles. Storage is always UTC regardless.
DEFAULT_TIMEZONE=UTC

# Default delivery time, in the user's own timezone.
DIGEST_DEFAULT_TIME=07:00

# Where the local embedding model (~120 MB) is cached. Empty means
# ~/.cache/mifluent/models.
MODELS_DIR=

# Cosine similarity above which two events are treated as the same story.
CLUSTER_THRESHOLD=0.92

# Hard daily ceiling on model spend for the whole instance, in USD. When it is
# reached, model work stops until 00:00 UTC and digests say so.
DAILY_COST_CAP_USD=1.0

# The worker touches this file once a minute, for a container healthcheck.
# Leave empty outside a container.
WORKER_HEARTBEAT_FILE=

# Plan limits can be overridden per plan and field, for example:
#   PLAN_FREE_MAX_TARGETS=5
#   PLAN_PRO_DAILY_DIGEST=true
# Plans: FREE, PRO, TEAM. Fields: MAX_TARGETS, MAX_PROFILES,
# DISCOVERY_PER_MONTH, DIFF_INTERVAL_MIN, RAW_RETENTION_DAYS, DAILY_DIGEST.
