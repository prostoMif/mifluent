{
  "name": "@mifluent/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Business rules: tenancy, roles, watch profiles",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./geo/countries": {
      "types": "./dist/geo/countries.d.ts",
      "default": "./dist/geo/countries.js"
    },
    "./geo/detect": {
      "types": "./dist/geo/detect.d.ts",
      "default": "./dist/geo/detect.js"
    },
    "./onboarding/pending": {
      "types": "./dist/onboarding/pending.d.ts",
      "default": "./dist/onboarding/pending.js"
    },
    "./jobs/queues": {
      "types": "./dist/jobs/queues.d.ts",
      "default": "./dist/jobs/queues.js"
    },
    "./billing/pricing": {
      "types": "./dist/billing/pricing.d.ts",
      "default": "./dist/billing/pricing.js"
    },
    "./profiles/delivery-types": {
      "types": "./dist/profiles/delivery-types.d.ts",
      "default": "./dist/profiles/delivery-types.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@mifluent/core": "*",
    "@mifluent/db": "*",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
